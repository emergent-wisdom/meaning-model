{
  "name": "@emergent-wisdom/meaning-model-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.emergent-wisdom/meaning-model",
  "description": "Meaning Model MCP server with a Rust engine and versioned modeling resources",
  "author": "Henrik Westerberg",
  "homepage": "https://github.com/emergent-wisdom/meaning-model#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emergent-wisdom/meaning-model.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/emergent-wisdom/meaning-model/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "meaning-model",
    "modeling",
    "simulation",
    "rust"
  ],
  "license": "(MIT AND CC-BY-4.0)",
  "type": "module",
  "bin": {
    "meaning-model-mcp": "bin/meaning-model-mcp.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node bin/meaning-model-mcp.mjs",
    "build:engine": "node bin/meaning-model-mcp.mjs --build-engine",
    "install:engine": "node bin/meaning-model-mcp.mjs --install-engine",
    "test": "node --test test/*.test.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "prepack": "node scripts/require-staged-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
